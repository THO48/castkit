<?xml version="1.0" encoding="utf-8"?>
<!--
  发送端启动图标前景层：**描边版 cast**。

  来源：Material Design Icons (Pictogrammers) 的 `cast`
        https://github.com/Templarian/MaterialDesign
  许可：Apache-2.0（其 LICENSE 中注明 "Icons: Apache 2.0"），署名见 docs/THIRD_PARTY.md

  与接收端配套：接收端用 Material Symbols 的 `cast`（**实心版**）。
  两个图标**形状相同、字重不同** —— 既像同一套产品，又能在桌面上一眼分开。
  刻意避开 `cast` + `connected_tv` 那种组合：两者都是"矩形 + 波纹"，小尺寸下分不出来。

  画布 108×108 是自适应图标规范，安全区为中间 66dp。
  原始图形 24×24，用 group 缩放 2.5 倍并平移 24，占中间 60×60。
  （VectorDrawable 的 group 变换是 translate × scale 且 pivot 默认 0，
    所以 (0,0)→(24,24)、(24,24)→(84,84)。）

  顺带修掉了旧版本里的坏路径：原来两段"投屏波纹"中
  `M78,30 a12,12 0 0 1 0,0` 起终点相同，是退化弧，在设备上根本不渲染。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="24"
        android:translateY="24">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M1 10v2a9 9 0 0 1 9 9h2c0-6.08-4.93-11-11-11m0 4v2a5 5 0 0 1 5 5h2a7 7 0 0 0-7-7m0 4v3h3a3 3 0 0 0-3-3M21 3H3c-1.11 0-2 .89-2 2v3h2V5h18v14h-7v2h7a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2" />
    </group>
</vector>
